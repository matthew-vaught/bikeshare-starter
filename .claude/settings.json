{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_leakage.sh",
            "timeout": 60,
            "statusMessage": "Re-running leakage tests..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m src.:*)",
      "Bash(git diff:*)",
      "Bash(git status)"
    ],
    "deny": [
      "Write(./data/raw/**)",
      "Edit(./data/raw/**)",
      "Bash(rm -rf:*)"
    ]
  }
}
